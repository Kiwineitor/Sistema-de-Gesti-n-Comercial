# Copia este archivo a .env y ajusta los valores si lo necesitas

# Base de datos interna (contenedor postgres)
DB_NAME=ekwe_iyawe
DB_USER=ekwe
DB_PASSWORD=ekwe_pass
DB_PORT=5434

# Aplicación
APP_PORT=8080
# Desarrollo local por HTTP. En producción: prod, HTTPS y SESSION_COOKIE_SECURE=true.
SPRING_PROFILES_ACTIVE=dev
SESSION_COOKIE_SECURE=false
# Con proxy inverso de confianza: FORWARD_HEADERS_STRATEGY=native.
# El límite de login usa request.getRemoteAddr(), sin leer X-Forwarded-For directamente.
FORWARD_HEADERS_STRATEGY=none
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# Contraseñas de los usuarios iniciales (solo se usan al crear la base por primera vez).
# Son contraseñas de demostración para desarrollo y revisión.
# En producción (SPRING_PROFILES_ACTIVE=prod) el sistema no arranca con ellas: define otras.
SEED_ADMIN_PASSWORD=admin123
SEED_MESERO_PASSWORD=mesero123
SEED_COCINA_PASSWORD=cocina123

# Cargar menú de ejemplo si la BD está vacía
SEED_DEMO_DATA=true

# Visor web de la BD (perfil "tools")
ADMINER_PORT=8081
