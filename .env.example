# Configuración para instalar el sistema en el negocio.
# Copia este archivo como .env, cambia los valores marcados y ejecuta: docker compose up -d --build
# Para pruebas y desarrollo no hace falta .env (ver README).

SPRING_PROFILES_ACTIVE=prod

# Base de datos interna. Cambia DB_PASSWORD por una contraseña larga antes del primer arranque.
DB_NAME=ekwe_iyawe
DB_USER=ekwe
DB_PASSWORD=CAMBIAR_por_una_clave_larga
DB_PORT=5434

APP_PORT=8080

# Contraseña TEMPORAL del usuario admin. Solo se usa al crear la base vacía;
# en el primer ingreso el dueño debe reemplazarla por una propia.
SEED_ADMIN_PASSWORD=CAMBIAR_clave_temporal
# Déjalas vacías: el dueño crea las cuentas de su personal desde Usuarios.
SEED_MESERO_PASSWORD=
SEED_COCINA_PASSWORD=

SEED_DEMO_DATA=false

# Acceso por http:// en la red local: false. Detrás de un proxy HTTPS: true y FORWARD_HEADERS_STRATEGY=native.
SESSION_COOKIE_SECURE=false
FORWARD_HEADERS_STRATEGY=none

LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

ADMINER_PORT=8081
